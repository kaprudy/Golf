{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	# Banenlijst rechtstreeks uit de app (voor banen.html)
	handle /data/courses.js {
		root * /srv/app
		rewrite * /courses.js
		file_server
	}

	handle {
		root * /srv/site
		file_server
	}
}
